# ARACHNID Rover Configuration Environment Variables

# Backend Service Port & Host
ARACHNID_HOST=0.0.0.0
ARACHNID_PORT=8100

# ROS2 Provider Mode: 'real', 'simulated', or 'mock'
ARACHNID_ROS2_PROVIDER=simulated

# ROS2 Bridge Connection Settings (For RealROS2Provider)
ROS2_BRIDGE_HOST=127.0.0.1
ROS2_BRIDGE_PORT=9090

# Frontend URL Defaults
VITE_API_BASE_URL=http://127.0.0.1:8100/api
VITE_WS_URL=ws://127.0.0.1:8100/ws
