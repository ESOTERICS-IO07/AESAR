<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arachnid_bringup</name>
  <version>1.0.0</version>
  <description>ARACHNID Unified Bringup Package - Person A (Robotics &amp; Autonomy)</description>
  <maintainer email="team@arachnid.ai">ARACHNID Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_interface</exec_depend>
  <exec_depend>odometry</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>mapping</exec_depend>
  <exec_depend>exploration</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>motor_bridge</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
